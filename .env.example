# ==============================================================================
# AI VIDEO STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your credentials before running the app.
# NEVER commit your actual `.env` file or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION, SERVER & LOGGING
# ------------------------------------------------------------------------------
APP_NAME="AI Video Studio"
APP_ENV=development                     # development | staging | production
APP_DEBUG=true                          # Set to false in production
HOST=0.0.0.0
PORT=8000
WORKERS=1                               # Keep 1 in dev; tune with external queue in prod
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-long-random-hex-string
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. CONCURRENCY, BATCHING & AUTO-CLEANUP TTL
# ------------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=3                   # Max parallel pipeline render/AI tasks
MAX_BATCH_SIZE=10                       # Max URLs/files per batch translation request
JOB_TIMEOUT_SECONDS=900                 # Hard timeout per job (15 minutes)
MAX_UPLOAD_MB=500                       # Max local video/audio upload size in MB

TEMP_DIR=./temp                         # Working root for temp/{job_id}/ artifacts
CLEANUP_AFTER_RENDER=true               # Immediately delete temp/{job_id}/ after upload
AUTO_CLEANUP_ENABLED=true               # Background janitor worker for stale temp dirs
AUTO_CLEANUP_INTERVAL_MINUTES=30        # How often the cleanup worker scans TEMP_DIR
TEMP_TTL_HOURS=24                       # Max lifetime for abandoned/failed temp/{job_id}/

# ------------------------------------------------------------------------------
# 3. PROVIDER FACTORY SWITCHES (PLUGGABLE ADAPTERS)
# ------------------------------------------------------------------------------
# Pipeline 1 & 2 default to Cloud-First lightweight providers.
# These act as platform defaults and can be overridden per-job via UI config.
SEPARATION_PROVIDER=fast_mode           # fast_mode | replicate | local_demucs
STT_PROVIDER=groq                       # groq | faster_whisper
LLM_PROVIDER=gemini                     # gemini
TTS_PROVIDER=edge_tts                   # edge_tts | elevenlabs | fpt_ai | viettel_ai
VISUAL_PROVIDER=pexels                  # pexels | pixabay | flux | stable_diffusion
STORAGE_PROVIDER=supabase               # supabase | local

# ------------------------------------------------------------------------------
# 4. AI & MEDIA PROVIDER API KEYS / ENDPOINTS
# ------------------------------------------------------------------------------
# --- Speech-to-Text (Groq Whisper Cloud + Local Fallback) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3
# Optional local fallback (requires optional faster-whisper package)
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu               # cpu | cuda
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- LLM: Storyboard, Script & Time-Synced Translation (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Vocal / BGM Separation (Replicate Demucs) ---
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
REPLICATE_DEMUCS_MODEL=cjwbw/demucs:25a173108cff36ef9f80f854c162d01df9e6528be175794b81158fa03836d953
SEPARATION_FAST_MODE_DUCK_DB=-14        # Fallback attenuation when skipping Demucs

# --- Text-to-Speech (TTS) Providers ---
# Edge-TTS (Free default, no API key required)
EDGE_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_MAX_SPEED_PCT=25               # Max adaptive speedup (+0% to +25%) for sync

# ElevenLabs (Premium multilingual & voice cloning)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# FPT.AI (Vietnamese natural voices)
FPT_AI_API_KEY=your_fpt_ai_api_key_here
FPT_AI_BASE_URL=https://api.fpt.ai/hmi/tts/v5
FPT_AI_DEFAULT_VOICE=banmai

# Viettel AI (Vietnamese regional voices)
VIETTEL_AI_TOKEN=your_viettel_ai_token_here
VIETTEL_AI_BASE_URL=https://viettelai.vn/tts/speech_synthesis
VIETTEL_AI_DEFAULT_VOICE=hn-quynhanh

# --- Visual Engine Providers (Stock Footage & AI Image Gen) ---
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Flux / Stable Diffusion Adapter (Replicate, Fal, Together, or self-hosted API)
FLUX_API_KEY=your_flux_api_key_here
FLUX_API_URL=https://api.replicate.com/v1/predictions
FLUX_MODEL=black-forest-labs/flux-schnell

SD_API_KEY=your_stable_diffusion_api_key_here
SD_API_URL=https://api.stability.ai/v2beta/stable-image/generate/core
SD_MODEL=sd3.5-large-turbo

# ------------------------------------------------------------------------------
# 5. FFMPEG ENGINE, HARDWARE ACCELERATION & AUDIO DUCKING
# ------------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_HWACCEL=auto                     # auto | nvenc | qsv | videotoolbox | none
FFMPEG_VIDEO_CODEC=h264_nvenc           # Preferred hardware encoder when available
FFMPEG_FALLBACK_CODEC=libx264           # Guaranteed CPU fallback encoder
FFMPEG_PRESET=fast                      # ultrafast | superfast | veryfast | fast | medium
FFMPEG_CRF=23                           # Quality factor (18-28, lower = higher quality)
FFMPEG_AUDIO_CODEC=aac
FFMPEG_AUDIO_BITRATE=192k
FFMPEG_THREADS=0                        # 0 = auto-detect available CPU threads

# Audio sidechaincompress ducking (TTS voiceover lowers BGM automatically)
FFMPEG_DUCKING_THRESHOLD=0.03
FFMPEG_DUCKING_RATIO=6
FFMPEG_DUCKING_ATTACK=20
FFMPEG_DUCKING_RELEASE=250

# ------------------------------------------------------------------------------
# 6. SUPABASE (POSTGRESQL, AUTH & STORAGE BUCKET)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_STORAGE_BUCKET=video-studio-assets
SUPABASE_SIGNED_URL_TTL_SECONDS=86400   # 24h signed URL expiry for private downloads

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (SEPAY / CASSO) & VIETQR CONFIGURATION
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=sepay                   # sepay | casso
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here
CASSO_API_KEY=your_casso_api_key_here
CASSO_WEBHOOK_SECRET=your_casso_webhook_secret_here

# VietQR Bank Info (used to generate dynamic QR codes on Top-Up UI)
VIETQR_BANK_BIN=970422                  # e.g., 970422 (MB Bank), 970436 (VCB), 970415 (VTB)
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
VIETQR_TEMPLATE=compact2                # compact | compact2 | qr_only | print
PAYMENT_MEMO_PREFIX=AVS                 # Transfer memo format: AVS<USER_SHORT_ID>
VND_PER_CREDIT=100                      # Exchange rate: 100 VND = 1 Credit (10,000 VND = 100 Credits)

# ------------------------------------------------------------------------------
# 8. CREDIT PRICING & FREE-TIER WATERMARK SETTINGS
# ------------------------------------------------------------------------------
INITIAL_FREE_CREDITS=50
CREDITS_PER_SECOND_TRANSLATOR=1         # Base cost per video second (Auto-Dubber)
CREDITS_PER_SECOND_FACELESS=1           # Base cost per video second (Faceless Gen)
CREDITS_SURCHARGE_SEPARATION=10         # Extra credits when using Demucs vocal separation
CREDITS_SURCHARGE_PREMIUM_TTS=15        # Extra credits for ElevenLabs / FPT / Viettel TTS
CREDITS_SURCHARGE_AI_VISUAL=20          # Extra credits for Flux / Stable Diffusion visuals

# Free-Tier Watermark Policy (bypassed automatically for Pro / Enterprise tiers)
FREE_TIER_WATERMARK_ENABLED=true
WATERMARK_TEXT="AI Video Studio"
WATERMARK_IMAGE_PATH=                   # Optional PNG overlay path (falls back to text if empty)
WATERMARK_POSITION=bottom_right         # top_left | top_right | bottom_left | bottom_right
WATERMARK_OPACITY=0.65

# ------------------------------------------------------------------------------
# 9. LOCAL SANDBOX & TIER UPGRADE
# ------------------------------------------------------------------------------
LOCAL_SANDBOX_MODE=false                # Run full Studio locally without Supabase
SANDBOX_INITIAL_CREDITS=500             # Initial credits seeded for local demo user
PRO_UPGRADE_CREDITS=500                 # Credits required to upgrade to Pro tier
ENTERPRISE_UPGRADE_CREDITS=1500         # Credits required to upgrade to Enterprise tier
